+/** One bounded request. A new process gets a new transient parent capability. */
+function runAgentCandidate(reporter: Reporter, rename = false): { exitCode: ExitCodeValue } {
+  try {
+    const buffer = new Uint8Array(16385)
+    let used = 0
+    for (;;) {
+      const count = readSync(0, buffer, used, buffer.length - used, null)
+      if (count === 0) break
+      used += count
+      if (used === buffer.length) throw new CandidateBridgeError('invalid', 'Request exceeds 16 KiB')
+    }
+    const request: unknown = JSON.parse(Buffer.from(buffer.buffer, buffer.byteOffset, used).toString('utf8'))
+    const action = rename ? renameBatchCount : inspectCandidate
+    const result = action(process.env.PLCDEV_AGENT_CANDIDATE_ROOT ?? '', process.env.PLCDEV_AGENT_CAPABILITY ?? '', request)
+    return reporter.success(result, () => 'Candidate identity and saved-file digest verified; editor state remains unknown.')
+  } catch (error) {
+    if (error instanceof CandidateBridgeError) {
+      const code = error.kind === 'auth' ? ErrorCode.AuthRejected : error.kind === 'invalid' ? ErrorCode.InvalidArgument : ErrorCode.TargetError
+      const status = error.kind === 'auth' ? ExitCode.Auth : error.kind === 'invalid' ? ExitCode.Usage : ExitCode.TargetError
+      return reporter.failure({ code, message: error.message, details: { kind: error.kind } }, status)
+    }
+    // Never include request content, paths, env vars, tokens, or raw I/O errors.
+    return reporter.failure({ code: ErrorCode.InvalidArgument, message: 'Could not inspect candidate request.' }, ExitCode.Usage)
+  }
+}
