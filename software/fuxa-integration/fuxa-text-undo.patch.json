{
  "id": "PLCDEV_TEXT_UNDO_FIX",
  "package": "@frangoteam/fuxa@1.3.5",
  "file": "dist/assets/lib/svgeditor/fuxa-editor.min.js",
  "upstreamSha256": "b7437aa1f8641d977db4a90077aea687af0bc1db07fe3c76f30ef78413e62b3c",
  "reason": "Text edits use the pseudo-attribute #text. UndoManager must capture and compare textContent; getAttribute('#text') is always null. ChangeElementCommand already restores textContent correctly.",
  "replacements": [
    {
      "before": "o[n]=r,s[n]=r.getAttribute(t)",
      "after": "o[n]=r,s[n]=\"#text\"===t?r.textContent:r.getAttribute(t)"
    },
    {
      "before": "r[n]!=o.getAttribute(n)&&s.addSubCommand",
      "after": "r[n]!=(\"#text\"===n?o.textContent:o.getAttribute(n))&&s.addSubCommand"
    }
  ]
}
